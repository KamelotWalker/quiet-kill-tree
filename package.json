{
  "name": "quiet-kill-tree",
  "version": "0.2.0",
  "description": "Kill a child process tree on Windows or POSIX with promises, typed errors, and silent helpers.",
  "keywords": [
    "kill",
    "process-tree",
    "tree-kill",
    "tree-kill-alternative",
    "kill-process",
    "child-process",
    "taskkill",
    "process-cleanup",
    "cleanup",
    "sigterm",
    "sigkill",
    "signals",
    "windows",
    "posix",
    "process-management",
    "zombie-processes",
    "dev-server",
    "test-runner",
    "abortsignal",
    "nodejs"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "vite": "^6.4.5"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KamelotWalker/quiet-kill-tree.git"
  },
  "bugs": {
    "url": "https://github.com/KamelotWalker/quiet-kill-tree/issues"
  },
  "homepage": "https://github.com/KamelotWalker/quiet-kill-tree#readme",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
